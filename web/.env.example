SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Account auth uses only these public values; never use a service-role key here.
# Keep the project URL identical to SUPABASE_URL on the server.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Build-time flag: only 1 enables accounts. Changing it requires a new deployment.
NEXT_PUBLIC_ACCOUNT_TRACKING_ENABLED=0
INGEST_SECRET=your_ingest_secret_here

# PostHog(产品分析:自定义事件、回访/留存)。Project API Key,可公开。不填则只走 Vercel Analytics。
# 需建在 US Cloud(next.config.ts 的 /ingest 反代指向 us.i.posthog.com)。
NEXT_PUBLIC_POSTHOG_KEY=
